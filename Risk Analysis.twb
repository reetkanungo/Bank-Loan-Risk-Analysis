            <column caption='Repayment Rate' datatype='real' name='[Calculation_1250482423377923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Loan_Status] = &quot;Fully Paid&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Loan_Status] = &quot;Fully Paid&quot;&#13;&#10;    OR [Loan_Status] = &quot;Charged Off&quot;&#13;&#10;    THEN 1 ELSE 0 END&#13;&#10;)' />
            </column>
            <column caption='Employment Band' datatype='string' name='[Calculation_1250482424352772]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Employment_Length_Years] &lt; 3 THEN &quot;0-2 years&quot;&#13;&#10;ELSEIF [Employment_Length_Years] &lt; 7 THEN &quot;3-6 years&quot;&#13;&#10;ELSEIF [Employment_Length_Years] &lt; 11 THEN &quot;7-10 years&quot;&#13;&#10;ELSE &quot;11+ years&quot;&#13;&#10;END' />
            </column>
            <column caption='Employment Length Years' datatype='integer' name='[Employment_Length_Years]' role='measure' type='quantitative' />
            <column caption='Loan Status' datatype='string' name='[Loan_Status]' role='dimension' type='nominal' />
