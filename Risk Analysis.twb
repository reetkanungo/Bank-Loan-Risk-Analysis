      <aliases enabled='yes' />
      <column caption='Annual Income' datatype='integer' name='[Annual_Income]' role='measure' type='quantitative' />
      <column caption='Charged off Rate' datatype='real' name='[Calculation_1250482365657090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Loan_Status] = &quot;Charged Off&quot; THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Repayment Rate' datatype='real' name='[Calculation_1250482423377923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Loan_Status] = &quot;Fully Paid&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Loan_Status] = &quot;Fully Paid&quot;&#13;&#10;    OR [Loan_Status] = &quot;Charged Off&quot;&#13;&#10;    THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Employment Band' datatype='string' name='[Calculation_1250482424352772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Employment_Length_Years] &lt; 3 THEN &quot;0-2 years&quot;&#13;&#10;ELSEIF [Employment_Length_Years] &lt; 7 THEN &quot;3-6 years&quot;&#13;&#10;ELSEIF [Employment_Length_Years] &lt; 11 THEN &quot;7-10 years&quot;&#13;&#10;ELSE &quot;11+ years&quot;&#13;&#10;END' />
      </column>
      <column caption='DTI Band' datatype='string' name='[Calculation_1250482427269125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DTI] &lt; 10 THEN &quot;&lt;10%&quot;&#13;&#10;ELSEIF [DTI] &lt; 20 THEN &quot;10-19.9%&quot;&#13;&#10;ELSEIF [DTI] &lt; 30 THEN &quot;20-29.9%&quot;&#13;&#10;ELSEIF [DTI] &lt; 40 THEN &quot;30-39.9%&quot;&#13;&#10;ELSE &quot;40%+&quot;&#13;&#10;END' />
      </column>
      <column caption='Interest Rate Band' datatype='string' name='[Calculation_1250482449408006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Interest_Rate] &lt; 5 THEN &quot;&lt;5%&quot;&#13;&#10;ELSEIF [Interest_Rate] &lt; 10 THEN &quot;5-9.9%&quot;&#13;&#10;ELSEIF [Interest_Rate] &lt; 15 THEN &quot;10-14.9%&quot;&#13;&#10;ELSEIF [Interest_Rate] &lt; 20 THEN &quot;15-19.9%&quot;&#13;&#10;ELSEIF [Interest_Rate] &lt; 25 THEN &quot;20-24.9%&quot;&#13;&#10;ELSE &quot;25%+&quot;&#13;&#10;END' />
      </column>
      <column caption='Employment Length Years' datatype='integer' name='[Employment_Length_Years]' role='measure' type='quantitative' />
      <column caption='Funded Amount' datatype='integer' name='[Funded_Amount]' role='measure' type='quantitative' />
